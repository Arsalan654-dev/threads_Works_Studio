# ---- ThreadWorks Studio environment ----
# Copy this file to `.env` for local work. Never commit `.env`.
#
# Local defaults need no configuration at all: MongoDB on 127.0.0.1, the API on
# loopback:4000, and the Vite dev server on loopback:5173. The values below are
# the ones to change when hosting.

# ---- Database ----
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/embroidery_studio
# Hosted (MongoDB Atlas). Use the SRV string from Atlas, including the database
# name and URL-encoding any special characters in the password.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/embroidery_studio?retryWrites=true&w=majority

# ---- Backend ----
# Leave SERVER_HOST unset locally (loopback). In production an unset host
# becomes 0.0.0.0. Railway injects PORT, which takes precedence over
# SERVER_PORT.
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
# PORT=8080

# Browser origins allowed to call the API, comma-separated. Loopback is always
# allowed. For Vercel, set this to the production URL (and optionally the
# wildcard for preview deploys):
# CORS_ORIGINS=https://threadworks.vercel.app,https://*.vercel.app
CORS_ORIGINS=

# ---- Frontend (build time) ----
# Empty means "same origin" (the Vite proxy locally, or the API serving the
# built client). On Vercel set this to the Railway origin, without /api:
# VITE_API_URL=https://threadworks-api.up.railway.app
VITE_API_URL=

# Dev-server only; ignored in a production build.
VITE_SERVER_HOST=127.0.0.1
VITE_SERVER_PORT=4000
VITE_CLIENT_PORT=5173

# ---- Local filesystem roots (created on first run) ----
DATA_DIR=./data
PROJECT_FILE_DIR=./data/projects
EXPORT_DIR=./data/exports
BACKUP_DIR=./data/backups
UPLOAD_DIR=./data/uploads

# ---- Limits ----
MAX_UPLOAD_MB=25
MAX_PROJECT_MB=50

# Backups: how many timestamped folders to keep (0 = never prune)
BACKUP_KEEP=20

# Set to "development" for verbose request logging
NODE_ENV=development
LOG_LEVEL=info
